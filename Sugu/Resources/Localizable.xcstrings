    "Delete all learned and added words, and learned phrases?": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習した単語と追加した単語、学習したフレーズをすべて削除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除所有已学习和添加的词语，以及已学习的短语吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除所有已學習及自行加入的字詞，以及已學習的片語嗎？"
          }
        }
      }
    },
